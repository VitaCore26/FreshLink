# =================================================================
# FRESH LINK PRO — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# NE JAMAIS committer .env.local dans git.
# =================================================================

# --- Supabase (OBLIGATOIRE) ---
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_ici

# --- Mot de passe demo (développement uniquement) ---
# Définit le mot de passe partagé pour tous les comptes demo.
# En production, utilisez Supabase Auth à la place.
NEXT_PUBLIC_DEMO_PWD=votre_mot_de_passe_demo

# --- EmailJS (optionnel — notifications email) ---
# Trouvez ces valeurs dans : https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=votre_public_key

# --- Application ---
NEXT_PUBLIC_APP_NAME=FreshLink Pro
NEXT_PUBLIC_APP_VERSION=1.0.0
